{
  "name": "coscience",
  "private": true,
  "version": "0.1.0",
  "description": "Human-led AI research workbench",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"npm run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && set COSCIENCE_DEV_URL=http://127.0.0.1:5173&& electron .\"",
    "desktop:dir": "npm run build && electron-builder --win --x64 --dir",
    "desktop:portable": "npm run build && electron-builder --win portable --x64",
    "desktop:build": "npm run build && electron-builder --win --x64",
    "test": "node --test src/core/evidence-domain.test.ts src/ui/repository.test.ts src/ui/domain-adapter.test.ts src/remote/console.test.ts src/remote/adapter.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.coscience.desktop",
    "productName": "CoScience",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CoScience-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CoScience"
    },
    "portable": {
      "artifactName": "CoScience-${version}-${arch}-portable.${ext}"
    },
    "publish": null
  }
}
