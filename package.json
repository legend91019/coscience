{
  "name": "coscience",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"npm run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && set COSCIENCE_DEV_URL=http://127.0.0.1:5173&& electron .\"",
    "test": "node --test src/core/evidence-domain.test.ts src/ui/repository.test.ts src/ui/domain-adapter.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "latest",
    "electron": "latest",
    "wait-on": "latest"
  }
}
